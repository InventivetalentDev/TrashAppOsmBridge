# Port the server listens on
PORT=8689

# Public base URL of this bridge (OAuth callbacks + app redirects are built from it)
PUBLIC_URL=https://osmbridge.trashapp.cc

# true = OSM dev API (master.apis.dev.openstreetmap.org), false = live openstreetmap.org
OSM_DEV=true

# OAuth 2 app credentials (required)
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# OAuth 1 credentials (deprecated /auth1 flow, optional)
OSM_KEY=
OSM_SECRET=

# express-session secret (required)
SESSION_SECRET=

# Overpass API endpoint proxied by POST /interpreter
OVERPASS_URL=https://www.overpass-api.de/api/interpreter
